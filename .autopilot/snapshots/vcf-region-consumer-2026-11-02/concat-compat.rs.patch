+#[test]
+#[ignore = "release oracle: requires bcftools 1.24"]
+fn complete_compact_phase_handoffs_match_bcftools_1_24() {
+    assert_oracle_version();
+    let directory = tempfile::tempdir().unwrap();
+    let header = "##fileformat=VCFv4.3\n\
+##contig=<ID=chr1,length=100>\n\
+##FORMAT=<ID=GT,Number=1,Type=String,Description=\"Genotype\">\n\
+#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\tS1\tS2\n";
+    let fixtures = [
+        [
+            "chr1\t10\tl1\tA\tC\t.\tPASS\t.\tGT\t0|1\t0|0\n\
+chr1\t20\tl2\tG\tT\t.\tPASS\t.\tGT\t0|1\t1|0\n\
+chr1\t30\tl3\tC\tG\t.\tPASS\t.\tGT\t1|0\t0|1\n",
+            "chr1\t20\tl2\tG\tT\t.\tPASS\t.\tGT\t1|0\t1|0\n\
+chr1\t30\tl3\tC\tG\t.\tPASS\t.\tGT\t0|1\t0|1\n\
+chr1\t40\tl4\tT\tA\t.\tPASS\t.\tGT\t1|0\t0|1\n",
+        ],
+        [
+            "chr1\t10\tl1\tT\tC\t.\tPASS\t.\tGT\t0|1\t0|0\n\
+chr1\t20\tl2\tA\tC\t.\tPASS\t.\tGT\t0|1\t0|1\n\
+chr1\t30\tl3\tG\tT\t.\tPASS\t.\tGT\t0|1\t1|0\n",
+            "chr1\t20\tr2\tA\tC\t.\tPASS\t.\tGT\t0|1\t0|1\n\
+chr1\t30\tr3\tG\tT\t.\tPASS\t.\tGT\t1|0\t1|0\n\
+chr1\t40\tr4\tC\tA\t.\tPASS\t.\tGT\t0|1\t0|1\n",
+        ],
+    ];
+    let inputs: Vec<_> = fixtures
+        .into_iter()
+        .enumerate()
+        .map(|(case, chunks)| {
+            chunks
+                .into_iter()
+                .enumerate()
+                .map(|(chunk, body)| {
+                    let source = directory.path().join(format!("phase-{case}-{chunk}.vcf"));
+                    let compressed = directory
+                        .path()
+                        .join(format!("phase-{case}-{chunk}.vcf.gz"));
+                    fs::write(&source, format!("{header}{body}")).unwrap();
+                    index(&source, &compressed);
+                    compressed
+                })
+                .collect::<Vec<_>>()
+        })
+        .collect();
+    let cases = [
+        (
+            0,
+            false,
+            "30",
+            "chr1\t10\tl1\tA\tC\t.\tPASS\t.\tGT:PS\t0|1:10\t0|0:10\n\
+chr1\t20\tl2\tG\tT\t.\tPASS\t.\tGT:PS\t0|1:10\t1|0:10\n\
+chr1\t30\tl3\tC\tG\t.\tPASS\t.\tGT:PQ:PS\t1|0:99:10\t0|1:99:10\n\
+chr1\t40\tl4\tT\tA\t.\tPASS\t.\tGT:PS\t0|1:10\t0|1:10\n",
+        ),
+        (
+            0,
+            true,
+            "30",
+            "chr1\t10\tl1\tA\tC\t.\tPASS\t.\tGT:PS\t0|1:10\t0|0:10\n\
+chr1\t20\tl2\tG\tT\t.\tPASS\t.\tGT\t0|1\t1|0\n\
+chr1\t30\tl3\tC\tG\t.\tPASS\t.\tGT:PQ\t1|0:99\t0|1:99\n\
+chr1\t40\tl4\tT\tA\t.\tPASS\t.\tGT\t0|1\t0|1\n",
+        ),
+        (
+            1,
+            false,
+            "30",
+            "chr1\t10\tl1\tT\tC\t.\tPASS\t.\tGT:PS\t0|1:10\t0|0:10\n\
+chr1\t20\tl2\tA\tC\t.\tPASS\t.\tGT:PS\t0|1:10\t0|1:10\n\
+chr1\t30\tr3\tG\tT\t.\tPASS\t.\tGT:PQ:PS\t1|0:0:30\t1|0:99:10\n\
+chr1\t40\tr4\tC\tA\t.\tPASS\t.\tGT:PS\t0|1:30\t0|1:10\n",
+        ),
+        (
+            1,
+            true,
+            "30",
+            "chr1\t10\tl1\tT\tC\t.\tPASS\t.\tGT:PS\t0|1:10\t0|0:10\n\
+chr1\t20\tl2\tA\tC\t.\tPASS\t.\tGT\t0|1\t0|1\n\
+chr1\t30\tr3\tG\tT\t.\tPASS\t.\tGT:PQ:PS\t1|0:0:30\t1|0:99:.\n\
+chr1\t40\tr4\tC\tA\t.\tPASS\t.\tGT\t0|1\t0|1\n",
+        ),
+        (
+            1,
+            false,
+            "0",
+            "chr1\t10\tl1\tT\tC\t.\tPASS\t.\tGT:PS\t0|1:10\t0|0:10\n\
+chr1\t20\tl2\tA\tC\t.\tPASS\t.\tGT:PS\t0|1:10\t0|1:10\n\
+chr1\t30\tr3\tG\tT\t.\tPASS\t.\tGT:PQ:PS\t1|0:0:10\t1|0:99:10\n\
+chr1\t40\tr4\tC\tA\t.\tPASS\t.\tGT:PS\t0|1:10\t0|1:10\n",
+        ),
+        (
+            1,
+            true,
+            "0",
+            "chr1\t10\tl1\tT\tC\t.\tPASS\t.\tGT:PS\t0|1:10\t0|0:10\n\
+chr1\t20\tl2\tA\tC\t.\tPASS\t.\tGT\t0|1\t0|1\n\
+chr1\t30\tr3\tG\tT\t.\tPASS\t.\tGT:PQ\t1|0:0\t1|0:99\n\
+chr1\t40\tr4\tC\tA\t.\tPASS\t.\tGT\t0|1\t0|1\n",
+        ),
+    ];
+    for (fixture, compact, threshold, expected_body) in cases {
+        let mut outputs = Vec::new();
+        for (native, mut child) in [(true, ours()), (false, Command::new(oracle()))] {
+            child.arg("concat");
+            if !native {
+                child.args(["--no-version", "-Ov"]);
+            }
+            child.args(["--ligate", "--min-PQ", threshold]);
+            if compact {
+                child.arg("--compact-PS");
+            }
+            let output = run(child.args(&inputs[fixture]));
+            assert_eq!(
+                records(&output.stdout),
+                records(expected_body.as_bytes()),
+                "fixture={fixture}, compact={compact}, threshold={threshold}, native={native}"
+            );
+            outputs.push(output.stdout);
+        }
+        assert_eq!(canonical(&outputs[0]), canonical(&outputs[1]));
+    }
+}
