    105 pub(crate) fn read_fresh(input: &Path) -> Result<Box<dyn noodles_csi::BinningIndex>> {
    106     let is_vcf = crate::format::Reader::open(input)?.is_text();
    107     let (index, kind) = resolve_query_index(input, is_vcf)?;
    108     let input_modified = std::fs::metadata(input)
    109         .rs_with_context(|| format!("reading variant metadata {}", input.display()))?
    110         .modified()
    111         .rs_with_context(|| format!("reading variant modification time {}", input.display()))?;
    112     let index_modified = std::fs::metadata(&index)
    113         .rs_with_context(|| format!("reading index metadata {}", index.display()))?
    114         .modified()
    115         .rs_with_context(|| format!("reading index modification time {}", index.display()))?;
    116     if index_modified < input_modified {
    117         return Err(RsomicsError::InvalidInput(format!(
    118             "variant index is older than its input: {}",
    119             index.display()
    120         )));
    121     }
    122     match kind {
    123         IndexKind::Csi => noodles_csi::fs::read(&index)
    124             .map(|index| Box::new(index) as Box<dyn noodles_csi::BinningIndex>)
    125             .rs_with_context(|| format!("reading CSI index {}", index.display())),
    126         IndexKind::Tbi => noodles_tabix::fs::read(&index)
    127             .map(|index| Box::new(index) as Box<dyn noodles_csi::BinningIndex>)
    128             .rs_with_context(|| format!("reading TBI index {}", index.display())),
    129     }
    130 }
    131 
    132 fn resolve_query_index(input: &Path, is_vcf: bool) -> Result<(PathBuf, IndexKind)> {
    133     let kinds: &[_] = if is_vcf {
    134         &[IndexKind::Tbi, IndexKind::Csi]
    135     } else {
    136         &[IndexKind::Csi]
    137     };
    138     for &kind in kinds {
    139         let path = default_output_path(input, kind);
    140         match std::fs::symlink_metadata(&path) {
    141             Ok(_) => return Ok((path, kind)),
    142             Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
    143             Err(error) => {
    144                 return Err(error)
    145                     .rs_with_context(|| format!("reading index metadata {}", path.display()));
    146             }
    147         }
    148     }
    149     let expected = if is_vcf { "CSI or TBI" } else { "CSI" };
    150     Err(RsomicsError::InvalidInput(format!(
    151         "no {expected} index found for {}",
    152         input.display()
    153     )))
    154 }

