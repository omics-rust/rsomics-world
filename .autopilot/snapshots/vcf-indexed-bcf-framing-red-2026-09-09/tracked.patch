     712 fn gunzip(source: &[u8]) -> Vec<u8> {
     713     let mut output = Vec::new();
     714     flate2::read::MultiGzDecoder::new(source)
     715         .read_to_end(&mut output)
     716         .unwrap();
     717     output
     718 }
