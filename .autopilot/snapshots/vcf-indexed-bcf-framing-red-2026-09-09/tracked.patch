     852 #[test]
     853 fn malformed_bgzf_extra_subfields_preserve_existing_output() {
     854     let directory = tempfile::tempdir().unwrap();
     855     let input_path = directory.path().join("invalid.vcf.gz");
     856     let output_path = directory.path().join("output.vcf.gz");
     857     let canonical = bgzf_bytes(&[BCF_SOURCE]);
     858     for malformed in ["missing-bc", "duplicate-bc", "truncated-subfield", "crc"] {
     859         let after = match malformed {
     860             "duplicate-bc" => b"BC\x02\x00\x00\x00".as_slice(),
     861             "truncated-subfield" => b"XY\x02\x00\x07".as_slice(),
     862             _ => b"XY\x01\x00\x07".as_slice(),
     863         };
     864         let mut input = with_extra_subfields(&canonical, &[], after);
     865         if malformed == "missing-bc" {
     866             input[12] = b'X';
     867         } else if malformed == "crc" {
     868             let first_frame_size = usize::from(u16::from_le_bytes([input[16], input[17]])) + 1;
     869             input[first_frame_size - 8] ^= 1;
     870         }
     871         fs::write(&input_path, input).unwrap();
     872         fs::write(&output_path, b"existing output").unwrap();
     873         let result = command()
     874             .args(["reheader", "-n", "N1,N2", "-o"])
     875             .arg(&output_path)
     876             .arg(&input_path)
     877             .output()
     878             .unwrap();
     879         assert!(!result.status.success(), "{malformed}");
     880         assert!(result.stdout.is_empty());
     881         assert!(!result.stderr.is_empty());
     882         assert_eq!(
     883             fs::read(&output_path).unwrap(),
     884             b"existing output",
     885             "{malformed}"
     886         );
     887     }
     888 }
