    249 fn sparse_csi_slots(input: &Path, slots: usize) {
    250     use noodles_csi::binning_index::{
    251         Indexer,
    252         index::reference_sequence::{bin::Chunk, index::BinnedIndex},
    253     };
    254     let mut reader = bcf::io::Reader::new(File::open(input).unwrap());
    255     reader.read_header().unwrap();
    256     let mut indexer = Indexer::<BinnedIndex>::new(14, 5);
    257     let mut record = bcf::Record::default();
    258     loop {
    259         let start = reader.get_ref().virtual_position();
    260         if reader.read_record(&mut record).unwrap() == 0 {
    261             break;
    262         }
    263         let end = reader.get_ref().virtual_position();
    264         let reference = record.reference_sequence_id().unwrap();
    265         let position = record.variant_start().unwrap().unwrap();
    266         indexer
    267             .add_record(
    268                 Some((reference, position, position, true)),
    269                 Chunk::new(start, end),
    270             )
    271             .unwrap();
    272     }
    273     noodles_csi::fs::write(input.with_extension("bcf.csi"), &indexer.build(slots)).unwrap();
    274 }
