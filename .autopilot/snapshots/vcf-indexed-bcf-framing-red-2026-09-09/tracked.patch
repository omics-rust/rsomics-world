     725         header
     726             .sample_names()
     727             .iter()
     728             .map(String::as_str)
     729             .collect::<Vec<_>>(),
     730         ["N1", "N2"]
     731     );
     732     let mut writer = noodles_vcf::io::Writer::new(Vec::new());
     733     for record in reader.records(&header) {
     734         writer
     735             .write_variant_record(&header, record.unwrap().as_ref())
     736             .unwrap();
     737     }
     738     assert_eq!(writer.into_inner(), body(BCF_SOURCE));
     739 }
