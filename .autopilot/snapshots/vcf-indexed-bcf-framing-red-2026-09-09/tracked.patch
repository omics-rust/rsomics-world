     690 fn with_extra_subfields(source: &[u8], before: &[u8], after: &[u8]) -> Vec<u8> {
     691     let mut output = Vec::new();
     692     for original in raw_frames(source) {
     693         if original == crate_eof_block() {
     694             output.extend_from_slice(original);
     695             continue;
     696         }
     697         let mut frame = original[..12].to_vec();
     698         frame.extend_from_slice(before);
     699         frame.extend_from_slice(&original[12..18]);
     700         frame.extend_from_slice(after);
     701         frame.extend_from_slice(&original[18..]);
     702         let extra_length = u16::try_from(6 + before.len() + after.len()).unwrap();
     703         frame[10..12].copy_from_slice(&extra_length.to_le_bytes());
     704         let size = u16::try_from(frame.len() - 1).unwrap();
     705         let size_offset = 16 + before.len();
     706         frame[size_offset..size_offset + 2].copy_from_slice(&size.to_le_bytes());
     707         output.extend_from_slice(&frame);
     708     }
     709     output
     710 }
