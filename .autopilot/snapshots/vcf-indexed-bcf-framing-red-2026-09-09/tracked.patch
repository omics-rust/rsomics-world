     720 fn assert_renamed_variant_data(raw: &[u8]) {
     721     use noodles_vcf::variant::io::Write as _;
     722     let mut reader = noodles_util::variant::io::Reader::new(raw).unwrap();
     723     let header = reader.read_header().unwrap();
