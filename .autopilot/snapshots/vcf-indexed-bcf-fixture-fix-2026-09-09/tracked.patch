+fn query_bcf_records<'a>(
+    reader: &'a mut noodles_bcf::io::IndexedReader<bgzf::io::Reader<File>>,
+    header: &'a noodles_vcf::Header,
+    region: &Region,
+) -> io::Result<RawRecords<'a>> {
