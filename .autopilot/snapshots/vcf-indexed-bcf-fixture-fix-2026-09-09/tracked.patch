+
+pub(crate) fn read_fresh(input: &Path) -> Result<Box<dyn noodles_csi::BinningIndex>> {
+    let is_vcf = crate::format::Reader::open(input)?.is_text();
+    let (index, kind) = resolve_query_index(input, is_vcf)?;
+    let input_modified = std::fs::metadata(input)
+        .rs_with_context(|| format!("reading variant metadata {}", input.display()))?
+        .modified()
+        .rs_with_context(|| format!("reading variant modification time {}", input.display()))?;
+    let index_modified = std::fs::metadata(&index)
+        .rs_with_context(|| format!("reading index metadata {}", index.display()))?
+        .modified()
+        .rs_with_context(|| format!("reading index modification time {}", index.display()))?;
+    if index_modified < input_modified {
+        return Err(RsomicsError::InvalidInput(format!(
+            "variant index is older than its input: {}",
+            index.display()
+        )));
+    }
+    match kind {
+        IndexKind::Csi => noodles_csi::fs::read(&index)
+            .map(|index| Box::new(index) as Box<dyn noodles_csi::BinningIndex>)
+            .rs_with_context(|| format!("reading CSI index {}", index.display())),
+        IndexKind::Tbi => noodles_tabix::fs::read(&index)
+            .map(|index| Box::new(index) as Box<dyn noodles_csi::BinningIndex>)
+            .rs_with_context(|| format!("reading TBI index {}", index.display())),
+    }
+}
+
+fn resolve_query_index(input: &Path, is_vcf: bool) -> Result<(PathBuf, IndexKind)> {
+    let kinds: &[_] = if is_vcf {
+        &[IndexKind::Tbi, IndexKind::Csi]
+    } else {
+        &[IndexKind::Csi]
+    };
+    for &kind in kinds {
+        let path = default_output_path(input, kind);
+        match std::fs::symlink_metadata(&path) {
+            Ok(_) => return Ok((path, kind)),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(error) => {
+                return Err(error)
+                    .rs_with_context(|| format!("reading index metadata {}", path.display()));
+            }
+        }
+    }
+    let expected = if is_vcf { "CSI or TBI" } else { "CSI" };
+    Err(RsomicsError::InvalidInput(format!(
+        "no {expected} index found for {}",
+        input.display()
+    )))
+}
