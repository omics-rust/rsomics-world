+            io::Error::new(
+                io::ErrorKind::InvalidInput,
+                format!("reference sequence name does not exist in contigs: {name}"),
+            )
+        })?;
+    if reference != record_reference {
+        return Ok(false);
+    }
+    if interval.start().is_none() && interval.end().is_none() {
+        return Ok(true);
+    }
