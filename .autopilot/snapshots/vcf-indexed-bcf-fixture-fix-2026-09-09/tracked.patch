+pub(crate) fn read_bcf_record_checked<R: BufRead>(
+    reader: &mut bcf::io::Reader<R>,
+    record: &mut bcf::Record,
+) -> io::Result<usize> {
+    loop {
+        match reader.get_mut().fill_buf() {
+            Ok([]) => return Ok(0),
+            Ok(_) => break,
+            Err(error) if error.kind() == io::ErrorKind::Interrupted => {}
+            Err(error) => return Err(error),
+        }
+    }
+    match reader.read_record(record)? {
+        0 => Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "BCF record has zero shared length",
+        )),
+        read => Ok(read),
+    }
+}
