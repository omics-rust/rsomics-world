+#[test]
+fn zero_bcf_shared_length_is_not_end_of_input() {
+    let fixture = BcfFixture::new("u");
+    let source = fs::read(&fixture.input).unwrap();
+    assert!(source.starts_with(b"BCF\x02\x02"));
+    assert_eq!(body(&decode_bcf(&source)), body(BCF_SOURCE));
+    let header_length =
+        usize::try_from(u32::from_le_bytes(source[5..9].try_into().unwrap())).unwrap();
+    let header_end = 9 + header_length;
+    let header = &source[..header_end];
+    let record = &source[header_end..];
+    let shared_length =
+        usize::try_from(u32::from_le_bytes(record[..4].try_into().unwrap())).unwrap();
+    let sample_length =
+        usize::try_from(u32::from_le_bytes(record[4..8].try_into().unwrap())).unwrap();
+    assert!(shared_length >= 24);
+    assert_eq!(record.len(), 8 + shared_length + sample_length);
+    assert!(body(&decode_bcf(header)).is_empty());
+    let zero_shared = [0; 4];
+    let zero_lengths = [0; 8];
+    let layouts = [
+        (
+            "zero-after-header",
+            vec![header, zero_shared.as_slice()],
+            header_end,
+        ),
+        (
+            "zero-after-record",
+            vec![header, record, zero_shared.as_slice()],
+            source.len(),
+        ),
+        (
+            "zero-lengths-after-header",
+            vec![header, zero_lengths.as_slice()],
+            header_end,
+        ),
+        (
+            "zero-before-record",
+            vec![header, zero_lengths.as_slice(), record],
+            header_end,
+        ),
+    ];
+    let directory = tempfile::tempdir().unwrap();
+    let input_path = directory.path().join("input.bcf");
+    let output_path = directory.path().join("output.bcf");
+    let mut failures = Vec::new();
+    for compressed in [false, true] {
+        let workers: &[&str] = if compressed { &["0", "2"] } else { &["0"] };
+        let valid = if compressed {
+            bgzf_bytes(&[header])
+        } else {
+            header.to_vec()
+        };
+        if compressed {
+            assert_eq!(gunzip(&valid), header);
+        }
+        fs::write(&input_path, &valid).unwrap();
+        for &threads in workers {
+            for stdin in [false, true] {
+                fs::write(&output_path, b"existing output").unwrap();
+                let mut command = command();
+                command
+                    .args([
+                        "reheader",
+                        "--json",
+                        "-n",
+                        "N1,N2",
+                        "--threads",
+                        threads,
+                        "-o",
+                    ])
+                    .arg(&output_path);
+                if stdin {
+                    command.arg("-").stdin(fs::File::open(&input_path).unwrap());
+                } else {
+                    command.arg(&input_path);
+                }
+                let result = command.output().unwrap();
+                let case = format!(
+                    "header-only, compressed={compressed}, threads={threads}, stdin={stdin}"
+                );
+                eprintln!(
+                    "BCF zero-length control: {case}, status={:?}",
+                    result.status.code()
+                );
+                if !result.status.success() {
+                    failures.push(format!(
+                        "{case}: {}",
+                        String::from_utf8_lossy(&result.stderr)
+                    ));
+                    continue;
+                }
+                let output = fs::read(&output_path).unwrap();
+                assert_eq!(output.starts_with(&[0x1f, 0x8b]), compressed, "{case}");
+                let decoded = if compressed {
+                    assert!(output.ends_with(crate_eof_block()), "{case}");
+                    gunzip(&output)
+                } else {
+                    output
+                };
+                assert!(decoded.starts_with(b"BCF\x02\x02"), "{case}");
+                let mut reader = noodles_bcf::io::Reader::from(decoded.as_slice());
+                let header = reader.read_header().unwrap();
+                assert!(reader.get_ref().is_empty(), "{case}");
+                assert_eq!(
+                    header
+                        .sample_names()
+                        .iter()
+                        .map(String::as_str)
+                        .collect::<Vec<_>>(),
+                    ["N1", "N2"],
+                    "{case}"
+                );
+                let mut record = noodles_bcf::Record::default();
+                assert_eq!(reader.read_record(&mut record).unwrap(), 0, "{case}");
+                assert!(reader.get_ref().is_empty(), "{case}");
+                let json: serde_json::Value = serde_json::from_slice(&result.stdout).unwrap();
+                assert_eq!(
+                    json["result"]["summary"]["encoding"],
+                    if compressed { "bgzf-bcf" } else { "raw-bcf" },
+                    "{case}"
+                );
+                assert_eq!(json["result"]["summary"]["samples_after"], 2, "{case}");
+            }
+        }
+        for (layout, parts, zero_at) in &layouts {
+            let raw = parts.concat();
+            assert_eq!(&raw[*zero_at..*zero_at + 4], &[0; 4]);
+            let input = if compressed {
+                let input = bgzf_bytes(parts);
+                assert_eq!(gunzip(&input), raw);
+                input
+            } else {
+                raw
+            };
+            fs::write(&input_path, &input).unwrap();
+            for &threads in workers {
+                for stdin in [false, true] {
+                    fs::write(&output_path, b"existing output").unwrap();
+                    let mut command = command();
+                    command
+                        .args(["reheader", "-n", "N1,N2", "--threads", threads, "-o"])
+                        .arg(&output_path);
+                    if stdin {
+                        command.arg("-").stdin(fs::File::open(&input_path).unwrap());
+                    } else {
+                        command.arg(&input_path);
+                    }
+                    let result = command.output().unwrap();
+                    let case = format!(
+                        "{layout}, compressed={compressed}, threads={threads}, stdin={stdin}"
+                    );
+                    eprintln!(
+                        "BCF zero shared length: {case}, status={:?}",
+                        result.status.code()
+                    );
+                    let preserved = fs::read(&output_path).unwrap() == b"existing output";
+                    if result.status.success() {
+                        failures.push(format!(
+                            "{case}: malformed record accepted, output_preserved={preserved}"
+                        ));
+                    } else if !result.stdout.is_empty() || result.stderr.is_empty() || !preserved {
+                        failures.push(format!(
+                            "{case}: invalid failure outcome, output_preserved={preserved}, stdout={}, stderr={}",
+                            String::from_utf8_lossy(&result.stdout),
+                            String::from_utf8_lossy(&result.stderr)
+                        ));
+                    }
+                }
+            }
+        }
+    }
+    assert!(failures.is_empty(), "{failures:#?}");
+}
