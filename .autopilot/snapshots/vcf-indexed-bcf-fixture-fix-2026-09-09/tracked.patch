+fn with_extra_subfields(source: &[u8], before: &[u8], after: &[u8]) -> Vec<u8> {
+    let mut output = Vec::new();
+    for original in raw_frames(source) {
+        if original == crate_eof_block() {
+            output.extend_from_slice(original);
+            continue;
+        }
+        let mut frame = original[..12].to_vec();
+        frame.extend_from_slice(before);
+        frame.extend_from_slice(&original[12..18]);
+        frame.extend_from_slice(after);
+        frame.extend_from_slice(&original[18..]);
+        let extra_length = u16::try_from(6 + before.len() + after.len()).unwrap();
+        frame[10..12].copy_from_slice(&extra_length.to_le_bytes());
+        let size = u16::try_from(frame.len() - 1).unwrap();
+        let size_offset = 16 + before.len();
+        frame[size_offset..size_offset + 2].copy_from_slice(&size.to_le_bytes());
+        output.extend_from_slice(&frame);
+    }
+    output
+}
+
+fn gunzip(source: &[u8]) -> Vec<u8> {
+    let mut output = Vec::new();
+    flate2::read::MultiGzDecoder::new(source)
+        .read_to_end(&mut output)
+        .unwrap();
+    output
+}
