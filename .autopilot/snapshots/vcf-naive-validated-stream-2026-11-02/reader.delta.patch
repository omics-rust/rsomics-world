+    pub(crate) fn open_bgzf(path: &Path) -> Result<Self> {
+        let input = File::open(path)
+            .rs_with_context(|| format!("opening BGZF variant input {}", path.display()))?;
+        Self::from_bgzf(input, path.display().to_string())
+    }
+
+    fn from_bgzf<R: Read + 'static>(input: R, source: String) -> Result<Self> {
+        let mut decoded = DecodedReader::new(BufReader::new(input));
+        let mut prefix = [0; 16];
+        let mut length = 0;
+        while length < prefix.len() {
+            match decoded.read(&mut prefix[length..]) {
+                Ok(0) => break,
+                Ok(read) => length += read,
+                Err(error) if error.kind() == io::ErrorKind::Interrupted => {}
+                Err(error) => return Err(invalid(&source, "detecting BGZF variant format", error)),
+            }
+        }
+        let prefix = prefix[..length].to_vec();
+        let bcf = prefix.starts_with(b"BCF\x02\x02");
+        if !bcf && !prefix.starts_with(b"##fileformat=VCF") {
+            return Err(RsomicsError::InvalidInput(format!(
+                "{source}: BGZF stream is not VCF or BCF 2.2"
+            )));
+        }
+        let input: Source = Box::new(Cursor::new(prefix).chain(decoded));
+        let buffered = BufReader::new(input);
+        let inner = if bcf {
+            Inner::BcfRaw(bcf::io::Reader::from(buffered))
+        } else {
+            Inner::Vcf(buffered)
+        };
         Ok(Self { inner, source })
     }
 
