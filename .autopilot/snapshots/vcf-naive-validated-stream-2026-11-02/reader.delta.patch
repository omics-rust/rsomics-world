+    #[test]
+    fn detects_vcf_magic_split_across_bgzf_frames() {
+        use crate::format::bgzf::EOF_BLOCK;
+
+        let mut stream = Vec::new();
+        for chunk in [
+            b"#".as_slice(),
+            b"#file".as_slice(),
+            b"format=VCFv4.3\n".as_slice(),
+            b"##contig=<ID=sq0,length=10>\n\
+#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\n\
+sq0\t1\t.\tA\tC\t.\tPASS\t.\n"
+                .as_slice(),
+        ] {
+            let mut frame = bgzf_bytes(chunk);
+            frame.truncate(frame.len() - EOF_BLOCK.len());
+            stream.extend_from_slice(&frame);
+        }
+        stream.extend_from_slice(&EOF_BLOCK);
+        let mut reader = Reader::from_bgzf(Cursor::new(stream), "split magic".to_owned()).unwrap();
+        let (header, _, _) = reader.read_header().unwrap();
+        let mut scratch = RecordScratch::default();
+        let record = reader
+            .read_record(&header, &mut scratch, 1)
+            .unwrap()
+            .unwrap();
+        assert_eq!(record.reference_sequence_name(), "sq0");
+        assert_eq!(usize::from(record.variant_start().unwrap()), 1);
+        assert!(
+            reader
+                .read_record(&header, &mut scratch, 2)
+                .unwrap()
+                .is_none()
+        );
+    }
 
     #[test]
+    fn bgzf_constructor_handles_fragmented_and_interrupted_input() {
+        use noodles_vcf::variant::io::Write as _;
+
+        struct Fragmented {
+            bytes: Cursor<Vec<u8>>,
+            interrupt: bool,
+        }
+
+        impl Read for Fragmented {
+            fn read(&mut self, buffer: &mut [u8]) -> io::Result<usize> {
+                if buffer.is_empty() {
+                    return Ok(0);
+                }
+                self.interrupt = !self.interrupt;
+                if self.interrupt {
+                    return Err(io::ErrorKind::Interrupted.into());
+                }
+                self.bytes.read(&mut buffer[..1])
+            }
+        }
+
+        let text = b"##fileformat=VCFv4.3\n##contig=<ID=sq0,length=10>\n\
+#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\n\
+sq0\t1\t.\tA\tC\t.\tPASS\t.\n";
+        let mut vcf = vcf::io::Reader::new(text.as_slice());
+        let header = vcf.read_header().unwrap();
+        let mut writer = bcf::io::Writer::from(Vec::new());
+        writer.write_header(&header).unwrap();
+        writer
+            .write_variant_record(&header, &vcf.records().next().unwrap().unwrap())
+            .unwrap();
+        for raw in [text.to_vec(), writer.into_inner()] {
+            let input = Fragmented {
+                bytes: Cursor::new(bgzf_bytes(&raw)),
+                interrupt: false,
+            };
+            let mut reader = Reader::from_bgzf(input, "fragmented".to_owned()).unwrap();
+            let (header, _, _) = reader.read_header().unwrap();
+            let mut scratch = RecordScratch::default();
+            let record = reader
+                .read_record(&header, &mut scratch, 1)
+                .unwrap()
+                .unwrap();
+            let mut writer = vcf::io::Writer::new(Vec::new());
+            writer.write_variant_record(&header, &record).unwrap();
+            assert_eq!(writer.into_inner(), b"sq0\t1\t.\tA\tC\t.\tPASS\t.\n");
+            assert!(
+                reader
+                    .read_record(&header, &mut scratch, 2)
+                    .unwrap()
+                    .is_none()
+            );
+        }
+    }
