+#[test]
+fn naive_accepts_long_empty_frame_prefixes_in_either_input() {
+    use std::io::Read;
+
+    use noodles_vcf::variant::io::Write as _;
+
+    let fixture = Fixture::new();
+    let directory = fixture._directory.path();
+    let source = directory.join("prefix-second.vcf");
+    fs::write(
+        &source,
+        fs::read_to_string(&fixture.first)
+            .unwrap()
+            .replace("chr1\t10\ta\t", "chr1\t20\tb\t"),
+    )
+    .unwrap();
+    let mut empty = BGZF_EOF;
+    empty[4] = 1;
+    let prefix = empty.repeat(400);
+    assert!(prefix.len() > 8192);
+    let mut failures = Vec::new();
+    for encoding in ["z", "b"] {
+        let first = directory.join(format!("prefix-first-{encoding}"));
+        let second = directory.join(format!("prefix-second-{encoding}"));
+        let output_path = directory.join(format!("prefix-output-{encoding}"));
+        convert(&fixture.first, &first, encoding);
+        convert(&source, &second, encoding);
+        let originals = [fs::read(&first).unwrap(), fs::read(&second).unwrap()];
+        for prefixed in [0, 1] {
+            let inputs = [&first, &second];
+            for input in 0..2 {
+                let bytes = if input == prefixed {
+                    [prefix.as_slice(), originals[input].as_slice()].concat()
+                } else {
+                    originals[input].clone()
+                };
+                fs::write(inputs[input], bytes).unwrap();
+            }
+            for named in [false, true] {
+                let mut child = command();
+                child.args(["concat", "--naive", path(&first), path(&second)]);
+                if named {
+                    child.args(["--output", path(&output_path)]);
+                }
+                let output = child.output().unwrap();
+                let case = format!("{encoding}, prefixed={prefixed}, named={named}");
+                if !output.status.success() {
+                    failures.push(format!(
+                        "{case}: {}",
+                        String::from_utf8_lossy(&output.stderr)
+                    ));
+                    continue;
+                }
+                let bytes = if named {
+                    fs::read(&output_path).unwrap()
+                } else {
+                    output.stdout
+                };
+                let mut decoded = Vec::new();
+                flate2::read::MultiGzDecoder::new(bytes.as_slice())
+                    .read_to_end(&mut decoded)
+                    .unwrap();
+                let mut reader =
+                    noodles_util::variant::io::Reader::new(decoded.as_slice()).unwrap();
+                let header = reader.read_header().unwrap();
+                let mut writer = noodles_vcf::io::Writer::new(Vec::new());
+                for record in reader.records(&header) {
+                    writer
+                        .write_variant_record(&header, record.unwrap().as_ref())
+                        .unwrap();
+                }
+                assert_eq!(
+                    writer.into_inner(),
+                    b"chr1\t10\ta\tA\tC\t.\tPASS\tDP=4\tGT\t0/1\n\
+chr1\t20\tb\tA\tC\t.\tPASS\tDP=4\tGT\t0/1\n",
+                    "{case}"
+                );
+            }
+        }
+    }
+    assert!(failures.is_empty(), "{failures:#?}");
+}
