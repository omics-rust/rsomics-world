+#[test]
+fn naive_rejects_late_second_input_failures_before_any_output() {
+    fn frame(payload: &[u8]) -> Vec<u8> {
+        let mut writer = noodles_bgzf::io::Writer::new(Vec::new());
+        writer.write_all(payload).unwrap();
+        let mut bytes = writer.finish().unwrap();
+        bytes.truncate(bytes.len() - BGZF_EOF.len());
+        bytes
+    }
+
+    let fixture = Fixture::new();
+    let directory = fixture._directory.path();
+    let first = directory.join("late-first.vcf.gz");
+    let second = directory.join("late-second.vcf.gz");
+    let output_path = directory.join("late-output.vcf.gz");
+    convert(&fixture.first, &first, "z");
+    let text = fs::read(&fixture.first).unwrap();
+    let header: Vec<_> = text
+        .split_inclusive(|byte| *byte == b'\n')
+        .take_while(|line| line.starts_with(b"#"))
+        .flatten()
+        .copied()
+        .collect();
+    for case in ["crc", "isize", "typed"] {
+        let body = if case == "typed" {
+            b"chr1\t30\tc\tG\tT\tbad\tPASS\tDP=8\tGT\t1/1\n".as_slice()
+        } else {
+            b"chr1\t30\tc\tG\tT\t.\tPASS\tDP=8\tGT\t1/1\n".as_slice()
+        };
+        let mut late = frame(body);
+        let length = late.len();
+        if case == "crc" {
+            late[length - 8] ^= 1;
+        } else if case == "isize" {
+            late[length - 4] ^= 1;
+        }
+        let bytes = [
+            frame(&header),
+            frame(b"chr1\t20\tb\tA\tC\t.\tPASS\tDP=4\tGT\t0/1\n"),
+            late,
+            BGZF_EOF.to_vec(),
+        ]
+        .concat();
+        fs::write(&second, bytes).unwrap();
+        for named in [false, true] {
+            fs::write(&output_path, b"existing output").unwrap();
+            let mut child = command();
+            child.args(["concat", "--naive", path(&first), path(&second)]);
+            if named {
+                child.args(["--output", path(&output_path)]);
+            }
+            let output = child.output().unwrap();
+            assert!(!output.status.success(), "{case}, named={named}");
+            assert!(output.stdout.is_empty(), "{case}, named={named}");
+            assert_eq!(
+                fs::read(&output_path).unwrap(),
+                b"existing output",
+                "{case}"
+            );
+            assert!(!output.stderr.is_empty(), "{case}, named={named}");
+        }
+    }
+}
